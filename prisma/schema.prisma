generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id           String   @id
  orgId        String
  actorUserId  String
  action       String
  entityType   String
  entityId     String
  createdAt    DateTime @default(now())
  metadataJson Json?

  @@index([actorUserId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([orgId])
}

model candidates {
  id             String           @id
  email          String?
  orgId          String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  fullName       String
  rawCVText      String           @default("")
  phone          String?
  profileUrl     String?
  orgs           orgs             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  evaluations    evaluations[]
  interviews     interviews[]
  job_candidates job_candidates[]

  @@index([orgId, createdAt])
  @@index([orgId, fullName])
  @@index([orgId])
}

model evaluations {
  id                    String               @id
  orgId                 String
  jobId                 String
  candidateId           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime
  finalScoreJson        Json?
  signalsJson           Json?
  rawModelOutputSnippet String?
  signalsGeneratedAt    DateTime?
  signalsPromptVersion  String?
  status                EvaluationStatus     @default(PENDING)
  completedAt           DateTime?
  riskLevel             EvaluationRiskLevel?
  candidates            candidates           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobs                  jobs                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  orgs                  orgs                 @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, jobId, candidateId])
  @@index([candidateId])
  @@index([jobId])
  @@index([orgId])
  @@index([orgId, jobId, candidateId])
  @@index([orgId, jobId, status])
  @@index([orgId, riskLevel, completedAt])
  @@index([orgId, status, completedAt])
}

model interviews {
  id              String                  @id
  orgId           String
  jobId           String
  candidateId     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime
  transcriptText  String                  @default("")
  type            InterviewType           @default(SCREENING)
  status          InterviewStatus         @default(SCHEDULED)
  scheduledAt     DateTime?
  durationMinutes Int                     @default(45)
  interviewers    String                  @default("")
  locationOrLink  String                  @default("")
  notes           String                  @default("")
  outcomeResult   InterviewOutcomeResult?
  outcomeSummary  String                  @default("")
  strengths       String[]                @default([])
  concerns        String[]                @default([])
  candidates      candidates              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobs            jobs                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  orgs            orgs                    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId, candidateId, status])
  @@index([jobId])
  @@index([orgId])
  @@index([orgId, scheduledAt])
  @@index([orgId, status, scheduledAt])
}

model job_candidates {
  id          String           @id
  jobId       String
  candidateId String
  stage       CandidateStage   @default(ADDED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  source      AssignmentSource @default(MANUAL)
  addedBy     String?
  notes       String?
  candidates  candidates       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobs        jobs             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([candidateId, jobId])
  @@index([jobId])
  @@index([jobId, stage, createdAt])
  @@index([jobId, stage])
}

model job_skills {
  id              String          @id
  jobId           String
  skillId         String
  experienceLevel ExperienceLevel
  requirementType RequirementType
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  jobs            jobs            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skills          skills          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}

model jobs {
  id                        String             @id
  title                     String
  orgId                     String
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime
  rawJD                     String             @default("")
  status                    JobStatus          @default(DRAFT)
  jdAnalyzedAt              DateTime?
  jdExtractionJson          Json?
  jdPromptVersion           String?
  interviewKitGeneratedAt   DateTime?
  interviewKitJson          Json?
  interviewKitPromptVersion String?
  jdAnalysisStatus          JDAnalysisStatus   @default(NOT_STARTED)
  jdLastError               String?
  interviewKitLastError     String?
  interviewKitStatus        InterviewKitStatus @default(NOT_STARTED)
  department                String?
  employmentType            String?
  hiringManager             String?
  location                  String?
  numberOfOpenings          Int?
  seniorityLevel            String?
  evaluations               evaluations[]
  interviews                interviews[]
  job_candidates            job_candidates[]
  job_skills                job_skills[]
  orgs                      orgs               @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([jdAnalyzedAt])
  @@index([orgId, createdAt])
  @@index([orgId])
  @@index([orgId, jdAnalysisStatus])
  @@index([orgId, status, createdAt])
  @@index([orgId, status])
  @@index([orgId, updatedAt])
}

model org_members {
  id        String   @id
  orgId     String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime
  orgs      orgs     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model orgs {
  id                String        @id
  name              String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  jdAnalysisCount   Int           @default(0)
  interviewKitCount Int           @default(0)
  candidates        candidates[]
  evaluations       evaluations[]
  interviews        interviews[]
  jobs              jobs[]
  org_members       org_members[]
}

model skills {
  id         String       @id
  name       String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  job_skills job_skills[]
}

model users {
  id          String        @id
  clerkUserId String        @unique
  email       String
  name        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  org_members org_members[]
}

enum AssignmentSource {
  MANUAL
  IMPORT
  REFERRAL
  APPLIED
}

enum CandidateStage {
  ADDED
  AWAITING_INTERVIEW
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  EVALUATION_PENDING
  EVALUATED
  DECISION_MADE
}

enum EvaluationRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum EvaluationStatus {
  PENDING
  COMPLETED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum InterviewKitStatus {
  NOT_STARTED
  RUNNING
  DONE
  FAILED
  OUTDATED
}

enum InterviewOutcomeResult {
  STRONG_YES
  YES
  MIXED
  NO
  STRONG_NO
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewType {
  SCREENING
  TECHNICAL
  MANAGERIAL
  HR
  FINAL
  CULTURE_FIT
  CUSTOM
}

enum JDAnalysisStatus {
  NOT_STARTED
  RUNNING
  DONE
  FAILED
  OUTDATED
}

enum JobStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RequirementType {
  REQUIRED
  OPTIONAL
}

enum Role {
  OWNER
  MEMBER
}
