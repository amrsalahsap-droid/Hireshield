generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String      @id @default(cuid())
  clerkUserId    String      @unique
  email          String
  name           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orgMemberships OrgMember[]

  @@map("users")
}

model Org {
  id                String       @id @default(cuid())
  name              String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  jdAnalysisCount   Int          @default(0)
  interviewKitCount Int          @default(0)
  candidates        Candidate[]
  evaluations       Evaluation[]
  interviews        Interview[]
  jobs              Job[]
  members           OrgMember[]

  @@map("orgs")
}

model OrgMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

model Job {
  id                        String             @id @default(cuid())
  title                     String
  orgId                     String
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  rawJD                     String             @default("")
  status                    JobStatus          @default(DRAFT)
  jdAnalyzedAt              DateTime?
  jdExtractionJson          Json?
  jdPromptVersion           String?
  interviewKitGeneratedAt   DateTime?
  interviewKitJson          Json?
  interviewKitPromptVersion String?
  jdAnalysisStatus          JDAnalysisStatus   @default(NOT_STARTED)
  jdLastError               String?
  interviewKitLastError     String?
  interviewKitStatus        InterviewKitStatus @default(NOT_STARTED)
  department                String?
  employmentType            String?
  hiringManager             String?
  location                  String?
  numberOfOpenings          Int?
  seniorityLevel            String?
  evaluations               Evaluation[]
  interviews                Interview[]
  skills                    JobSkill[]
  org                       Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([jdAnalyzedAt])
  @@map("jobs")
}

model Candidate {
  id          String       @id @default(cuid())
  email       String?
  orgId       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  fullName    String
  rawCVText   String       @default("")
  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]
  interviews  Interview[]

  @@index([orgId])
  @@map("candidates")
}

model Interview {
  id             String    @id @default(cuid())
  orgId          String
  jobId          String
  candidateId    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  transcriptText String    @default("")
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([jobId])
  @@index([candidateId])
  @@map("interviews")
}

model Evaluation {
  id                    String               @id @default(cuid())
  orgId                 String
  jobId                 String
  candidateId           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  finalScoreJson        Json?
  signalsJson           Json?
  rawModelOutputSnippet String?
  signalsGeneratedAt    DateTime?
  signalsPromptVersion  String?
  status                EvaluationStatus     @default(PENDING)
  completedAt           DateTime?
  riskLevel             EvaluationRiskLevel?
  candidate             Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                   Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  org                   Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, jobId, candidateId])
  @@index([orgId])
  @@index([orgId, status, completedAt])
  @@index([orgId, riskLevel, completedAt])
  @@index([jobId])
  @@index([candidateId])
  @@map("evaluations")
}

model AuditLog {
  id           String   @id @default(cuid())
  orgId        String
  actorUserId  String
  action       String
  entityType   String
  entityId     String
  createdAt    DateTime @default(now())
  metadataJson Json?

  @@index([orgId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Skill {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  jobSkills JobSkill[]

  @@map("skills")
}

model JobSkill {
  id              String          @id @default(cuid())
  jobId           String
  skillId         String
  experienceLevel ExperienceLevel
  requirementType RequirementType
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill           Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
  @@map("job_skills")
}

enum Role {
  OWNER
  MEMBER
}

enum JobStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum JDAnalysisStatus {
  NOT_STARTED
  RUNNING
  DONE
  FAILED
  OUTDATED
}

enum InterviewKitStatus {
  NOT_STARTED
  RUNNING
  DONE
  FAILED
  OUTDATED
}

enum EvaluationStatus {
  PENDING
  COMPLETED
}

enum EvaluationRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum RequirementType {
  REQUIRED
  OPTIONAL
}
