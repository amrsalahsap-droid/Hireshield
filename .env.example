# Database Configuration
# Replace with your actual PostgreSQL connection string
# Examples:
# - Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# - Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# - Local: postgresql://postgres:password@localhost:5432/hireshield
DATABASE_URL="postgresql://postgres:password@localhost:5432/hireshield"

# Optional: set to your real `org.id` from the DB (Prisma Studio / seed logs) so browser fetches match that workspace.
# If unset, signed-in users use their Clerk-provisioned org; unsigned dev traffic uses the first org in the DB.
NEXT_PUBLIC_ORG_ID=
# Optional server-only: used when there is no Clerk session and no x-org-id (dev only)
DEV_DEFAULT_ORG_ID=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YXNzdXJpbmctbW91c2UtNzIuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=••••••••••••••••••••••••••••••••••••••••••••••••••
# Optional: PEM public key from Clerk Dashboard → API Keys → JWT public key (networkless verification)
# CLERK_JWT_KEY=
# Optional: canonical app URL for request-based auth allowed origins (e.g. https://your-app.vercel.app)
# NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_TEMPERATURE_DEFAULT=0.2
OPENAI_TIMEOUT_MS=30000
# LLM HTTP timeout for OpenRouter/Groq/OpenAI adapters (default 120s if unset)
# LLM_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2

# Optional: in development only, use mock JD/suggestions after LLM rate limit, timeout, or network errors.
# Off by default (real API responses only). Enable for flaky free-tier local dev:
# AI_DEV_MOCK_FALLBACK=1
# (alias) AI_DEV_MOCK_ON_RATE_LIMIT=1
